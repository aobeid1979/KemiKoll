@page "/products"
@rendermode InteractiveServer
@using KemiKoll.Application.Products
@inject ListProducts ListProducts

@*
    The chemical inventory: one row per product. New products are added on /products/new.
    Interactive (server) rendering so the search box filters the list while typing.
    The matching rule is in ProductSearch (Application layer).
*@

<PageTitle>Products – KemiKoll</PageTitle>

<div class="page-header">
    <h1>Chemical products</h1>
    <div class="header-actions">
        @* A normal download link: "download" and data-enhance-nav="false" keep Blazor from handling it as a page. *@
        <a class="button secondary" href="products/export.xlsx" download data-enhance-nav="false">Export to Excel</a>
        <a class="button" href="products/new">+ Add product</a>
    </div>
</div>

@if (_products is null)
{
    <p>Loading…</p>
}
else if (_products.Count == 0)
{
    <p class="empty">No products yet.</p>
}
else
{
    @* Quick filters with counts. They work together with the search box. *@
    <div class="quick-filters" role="group" aria-label="Show">
        <button type="button" class="@FilterClass(ProductFilter.All)" aria-pressed="@(_filter == ProductFilter.All)"
                @onclick="() => _filter = ProductFilter.All">
            All <span class="count">@_products.Count</span>
        </button>
        <button type="button" class="@FilterClass(ProductFilter.NeedsAttention) attention" aria-pressed="@(_filter == ProductFilter.NeedsAttention)"
                @onclick="() => _filter = ProductFilter.NeedsAttention">
            Needs attention <span class="count">@_products.Count(ProductSearch.NeedsAttention)</span>
        </button>
        <button type="button" class="@FilterClass(ProductFilter.Hazardous)" aria-pressed="@(_filter == ProductFilter.Hazardous)"
                @onclick="() => _filter = ProductFilter.Hazardous">
            Hazardous <span class="count">@_products.Count(p => p.IsHazardous)</span>
        </button>
    </div>

    <div class="search">
        <label for="product-search" class="visually-hidden">Search products</label>
        <input id="product-search" type="search" placeholder="Search name, supplier or code, e.g. aspen H225"
               @bind="_searchText" @bind:event="oninput" />
        @if (VisibleProducts.Count != _products.Count)
        {
            <small>Showing @VisibleProducts.Count of @_products.Count</small>
        }
    </div>

    @if (VisibleProducts.Count == 0)
    {
        <p class="empty">No products match this search and filter.</p>
    }
    else
    {
    <table class="products">
        <thead>
            <tr>
                <th>Name</th>
                <th>Supplier</th>
                <th>Hazard statements</th>
                <th>Pictograms</th>
                <th>Hazardous</th>
                <th>Data sheet</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in VisibleProducts)
            {
                <tr @key="product.Id">
                    <td class="name">@product.Name</td>
                    <td>@product.Supplier</td>
                    <td>
                        @foreach (var hazardCode in product.HazardCodes)
                        {
                            <span class="code">@hazardCode</span>
                        }
                    </td>
                    <td class="pictograms">
                        @foreach (var pictogramCode in product.PictogramCodes)
                        {
                            <PictogramImage Code="@pictogramCode" Size="40" />
                        }
                        @* CLP check: do the pictograms match the hazard statements? *@
                        @if (product.MissingPictogramCodes.Count > 0)
                        {
                            <small class="pictogram-check">Missing: @string.Join(", ", product.MissingPictogramCodes)</small>
                        }
                        @if (product.UnexpectedPictogramCodes.Count > 0)
                        {
                            <small class="pictogram-check">Not expected: @string.Join(", ", product.UnexpectedPictogramCodes)</small>
                        }
                    </td>
                    <td>
                        @if (product.IsHazardous)
                        {
                            <span class="badge hazardous">Yes</span>
                        }
                        else
                        {
                            <span class="badge safe">No</span>
                        }
                    </td>
                    <td>
                        @switch (product.DataSheetStatus)
                        {
                            case DataSheetStatus.UpToDate:
                                <span class="badge safe">Up to date</span>
                                <small class="revision">rev. @FormatDate(product.DataSheetRevisionDate)</small>
                                break;
                            case DataSheetStatus.DueForReview:
                                <span class="badge review">Due for review</span>
                                <small class="revision">rev. @FormatDate(product.DataSheetRevisionDate)</small>
                                break;
                            case DataSheetStatus.Missing:
                                <span class="badge hazardous">Missing</span>
                                break;
                            default:
                                <span class="not-required">Not required</span>
                                break;
                        }
                    </td>
                    <td><a class="edit" href="products/@product.Id/edit" aria-label="Edit @product.Name">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>
    }
}

@code {
    // null = still loading; an empty list = loaded, but there are no products.
    private IReadOnlyList<ProductSummary>? _products;

    // The search text; the table shows only the matching products.
    private string _searchText = string.Empty;

    // The selected quick filter.
    private ProductFilter _filter = ProductFilter.All;

    private IReadOnlyList<ProductSummary> VisibleProducts => ProductSearch.Filter(_products ?? [], _searchText, _filter);

    private string FilterClass(ProductFilter filter) => filter == _filter ? "filter selected" : "filter";

    protected override async Task OnInitializedAsync()
    {
        _products = await ListProducts.ExecuteAsync();
    }

    // ISO format (2025-03-10), the same as on Swedish safety data sheets.
    private static string FormatDate(DateOnly? date) =>
        date?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
}
