@page "/products"
@using KemiKoll.Application.Products
@inject ListProducts ListProducts

@* The chemical inventory: one row per product. New products are added on /products/new. *@

<PageTitle>Products – KemiKoll</PageTitle>

<div class="page-header">
    <h1>Chemical products</h1>
    <a class="button" href="products/new">+ Add product</a>
</div>

@if (_products is null)
{
    <p>Loading…</p>
}
else if (_products.Count == 0)
{
    <p class="empty">No products yet.</p>
}
else
{
    <p class="summary">
        @_products.Count products, of which <strong>@_products.Count(p => p.IsHazardous) hazardous</strong>.
        @{
            var needAction = _products.Count(p => p.DataSheetStatus is DataSheetStatus.Missing or DataSheetStatus.DueForReview);
        }
        @if (needAction > 0)
        {
            <span class="attention">@needAction need attention.</span>
        }
    </p>

    <table class="products">
        <thead>
            <tr>
                <th>Name</th>
                <th>Supplier</th>
                <th>Hazard statements</th>
                <th>Pictograms</th>
                <th>Hazardous</th>
                <th>Data sheet</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in _products)
            {
                <tr @key="product.Id">
                    <td class="name">@product.Name</td>
                    <td>@product.Supplier</td>
                    <td>
                        @foreach (var hazardCode in product.HazardCodes)
                        {
                            <span class="code">@hazardCode</span>
                        }
                    </td>
                    <td class="pictograms">
                        @foreach (var pictogramCode in product.PictogramCodes)
                        {
                            <PictogramImage Code="@pictogramCode" Size="40" />
                        }
                    </td>
                    <td>
                        @if (product.IsHazardous)
                        {
                            <span class="badge hazardous">Yes</span>
                        }
                        else
                        {
                            <span class="badge safe">No</span>
                        }
                    </td>
                    <td>
                        @switch (product.DataSheetStatus)
                        {
                            case DataSheetStatus.UpToDate:
                                <span class="badge safe">Up to date</span>
                                <small class="revision">rev. @FormatDate(product.DataSheetRevisionDate)</small>
                                break;
                            case DataSheetStatus.DueForReview:
                                <span class="badge review">Due for review</span>
                                <small class="revision">rev. @FormatDate(product.DataSheetRevisionDate)</small>
                                break;
                            case DataSheetStatus.Missing:
                                <span class="badge hazardous">Missing</span>
                                break;
                            default:
                                <span class="not-required">Not required</span>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // null = still loading; an empty list = loaded, but there are no products.
    private IReadOnlyList<ProductSummary>? _products;

    protected override async Task OnInitializedAsync()
    {
        _products = await ListProducts.ExecuteAsync();
    }

    // ISO format (2025-03-10), the same as on Swedish safety data sheets.
    private static string FormatDate(DateOnly? date) =>
        date?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;
}
