# Settings for the local PostgreSQL database (docker-compose.yml).
#
# 1. Copy this file to .env   (Windows: copy .env.example .env   |   macOS/Linux: cp .env.example .env)
# 2. Choose your own password below.
#
# .env is ignored by Git, so your password is never committed. Only this example file is.

POSTGRES_DB=kemikoll
POSTGRES_USER=kemikoll
POSTGRES_PASSWORD=change-me-to-a-local-password
POSTGRES_PORT=5432
